# Port the API listens on
PORT=5000

# Secret used to sign login tokens. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Email. Leave SMTP_HOST empty in development to use a test inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Student Registration System <admin@outr.ac.in>"

# Used by docker compose. Copy to .env and fill in.

# Secret for signing login tokens (long random string)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Code needed to register an admin account (leave empty to disable admin sign-up)
ADMIN_INVITE_CODE=

# Optional: change these if you serve the app somewhere else
# FRONTEND_URL=http://localhost:8080
# VITE_API_URL=http://localhost:5000/api

# Optional: real SMTP server for emails (empty = test inbox)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
